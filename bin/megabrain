#!/bin/sh
# Use megabrain's tabs from any terminal — e.g. over SSH through Tailscale.
#
#   megabrain              list the tabs
#   megabrain <n|id>       attach to tab n (as listed) or by id — detach with Ctrl-b d
#   megabrain new [dir]    open a new tab in dir (default: here) and attach
#
# Tabs opened here show up in the web UI too, and vice versa.
set -eu

DIR=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
PORT=${PORT:-$(sed -n 's/.*"port": *\([0-9][0-9]*\).*/\1/p' "$DIR/config.json" 2>/dev/null | head -1)}
PORT=${PORT:-7680}

t() { tmux -L megabrain -f "$DIR/tmux.conf" "$@"; }

# In the web UI's order: pinned first (@megabrain_pinned), then the oldest first.
tabs() {
  t list-sessions -F '#{?#{@megabrain_pinned},#{@megabrain_pinned},999999}	#{session_created}	#{session_name}	#{?#{@megabrain_title},#{@megabrain_title},#{pane_title}}	#{pane_current_path}' 2>/dev/null |
    grep '	megabrain-' | sort -t '	' -k1,1n -k2,2n | cut -f3-
}

case "${1:-}" in
  "")
    list=$(tabs) || true
    if [ -z "$list" ]; then
      echo "No terminals. Create one with: megabrain new"
      exit 0
    fi
    echo "$list" | awk -F'\t' '{ printf "%2d  %-40s %s  (%s)\n", NR, $2, $3, substr($1, 11) }'
    ;;
  new)
    cwd=$(cd "${2:-.}" && pwd)
    body=$(printf '{"cwd":"%s"}' "$(printf '%s' "$cwd" | sed 's/\\/\\\\/g; s/"/\\"/g')")
    id=$(curl -fsS -X POST -H 'x-megabrain: 1' -H 'content-type: application/json' -d "$body" "http://127.0.0.1:$PORT/api/tabs" |
      sed -n 's/.*"id":"\([a-f0-9]*\)".*/\1/p')
    [ -n "$id" ] || { echo "could not create the terminal — is megabrain running?" >&2; exit 1; }
    exec tmux -L megabrain -f "$DIR/tmux.conf" attach -t "=megabrain-$id"
    ;;
  *)
    case "$1" in
      *[!0-9]*) name="megabrain-$1" ;;
      *) name=$(tabs | sed -n "${1}p" | cut -f1) ;;
    esac
    [ -n "$name" ] || { echo "terminal '$1' not found" >&2; exit 1; }
    exec tmux -L megabrain -f "$DIR/tmux.conf" attach -t "=$name"
    ;;
esac
